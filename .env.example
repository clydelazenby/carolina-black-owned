# Environment Configuration Template
# Carolina Black Owned - Frontend
# Copy this file to .env.development or .env.production and fill in values

# Backend API URL (Django server)
# Development: http://localhost:8000
# Production: https://api.carolinablackowned.com
REACT_APP_API_URL=http://localhost:8000

# API Version
REACT_APP_API_VERSION=v1

# Enable/disable debug mode
REACT_APP_DEBUG=true

# Google Maps API Key (optional - for map features)
REACT_APP_GOOGLE_MAPS_API_KEY=

# App Name
REACT_APP_NAME=Carolina Black Owned
